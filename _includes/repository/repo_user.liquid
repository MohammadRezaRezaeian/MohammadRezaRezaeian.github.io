<div class="repo p-2">
  <a class="repo-card d-block text-decoration-none" href="https://github.com/{{ include.username }}" rel="external nofollow noopener" target="_blank">
    <div class="repo-card-heading d-flex align-items-center justify-content-center mb-3">
      <span class="repo-icon d-flex align-items-center justify-content-center">
        <i class="fab fa-github" aria-hidden="true"></i>
      </span>
      <div class="repo-header-text text-left">
        <div class="repo-title">{{ include.username }}</div>
        <div class="repo-owner">GitHub profile</div>
      </div>
    </div>

    {% if include.description %}
      <p class="repo-description mb-0">{{ include.description }}</p>
    {% else %}
      <p class="repo-description mb-0">Open-source contributor and maintainer.</p>
    {% endif %}
  </a>
</div>

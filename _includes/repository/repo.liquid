{% if include.repository.name %}
  {% assign repo_name = include.repository.name %}
  {% assign repo_description = include.repository.description %}
  {% assign repo_icon_class = include.repository.icon %}
{% else %}
  {% assign repo_name = include.repository %}
  {% assign repo_description = '' %}
  {% assign repo_icon_class = 'fab fa-github' %}
{% endif %}

{% assign repo_url = repo_name | split: '/' %}
{% assign repo_owner = repo_url[0] %}
{% assign repo_title = repo_url[1] %}

<div class="repo p-2">
  <a class="repo-card d-block" href="https://github.com/{{ repo_name }}" rel="external nofollow noopener" target="_blank">
    <div class="repo-card-heading d-flex align-items-center mb-3">
      <span class="repo-icon d-flex align-items-center justify-content-center">
        <i class="{{ repo_icon_class }}" aria-hidden="true"></i>
      </span>
      <div class="repo-header-text text-left">
        <div class="repo-title">{{ repo_title }}</div>
        <div class="repo-owner">@{{ repo_owner }}</div>
      </div>
    </div>
    {% if repo_description != '' %}
      <p class="repo-description mb-0">{{ repo_description }}</p>
    {% endif %}
  </a>
</div>
